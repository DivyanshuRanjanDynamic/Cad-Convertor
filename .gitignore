lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script or a build system
#  (e.g. setup.py) before PyInstaller builds the executable, so we
#  ignore them.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

